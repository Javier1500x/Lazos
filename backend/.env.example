# ── Puerto del servidor ─────────────────────────────────────────────
PORT=5000

# ── MongoDB Atlas ────────────────────────────────────────────────────
# Obtén tu URI desde: https://cloud.mongodb.com
# Cluster -> Connect -> Drivers -> Node.js
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/lazos?retryWrites=true&w=majority

# ── Cloudinary ───────────────────────────────────────────────────────
# Obtén tus credenciales desde: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ── Frontend URL (para CORS) ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
